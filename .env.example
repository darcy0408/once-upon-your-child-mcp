# Where the Once Upon YOUR Child backend lives.
OUYC_API_BASE=https://story-weaver-app-production.up.railway.app

# Account. Access tokens live about an hour and refresh tokens about 30 days,
# so the server needs a way to re-authenticate on its own:
#
#   OUYC_CLIENT_ID  - the anonymous client id printed by scripts/setup-parent.ts.
#                     With this set the server can re-mint a session for the
#                     same account (same heroes) whenever a token expires.
#   OUYC_REFRESH_TOKEN - optional; tried before re-minting.
#   OUYC_TOKEN      - optional starting access token.
#
# Run `npx tsx scripts/setup-parent.ts` once to create the account and print
# all three. Leave OUYC_CLIENT_ID blank the first time; the server logs the
# id it was issued.
# OUYC_CLIENT_ID=
# OUYC_REFRESH_TOKEN=
# OUYC_TOKEN=

# Note on quotas: the backend counts bedtime (linear) stories per account.
# The free tier allows 3 a day and 5 a month; adventures are not counted.
# Put a demo account on a paid tier before showing it to judges.

# HTTP listener. Railway sets PORT for you.
PORT=3333
HOST=0.0.0.0

# Optional: default voice id for the narrate tool (see GET /tts/voices).
# OUYC_DEFAULT_VOICE_ID=

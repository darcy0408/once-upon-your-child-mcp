# Where the Once Upon YOUR Child backend lives.
OUYC_API_BASE=https://story-weaver-app-production.up.railway.app

# Option A: a long-lived bearer token for a parent account that has completed
# parental consent in the app. Preferred for demos.
# OUYC_TOKEN=

# Option B: anonymous session. The server calls POST /auth/anonymous and
# reclaims the same account each start when OUYC_CLIENT_ID is set. Leave it
# blank the first time; the server logs the id it was issued.
# OUYC_CLIENT_ID=

# HTTP listener. Railway sets PORT for you.
PORT=3333
HOST=0.0.0.0

# Optional: default voice id for the narrate tool (see GET /tts/voices).
# OUYC_DEFAULT_VOICE_ID=
